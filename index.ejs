<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Painel da Vendedora - Catálogo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body class="bg-light">

    <nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/"><i class="bi bi-shop me-2"></i>Minha Loja</a>
            <a href="/cadastrar" class="btn btn-light fw-bold">+ Novo Produto</a>
        </div>
    </nav>

    <div class="container">
        <h2 class="mb-4 text-secondary">Catálogo de Produtos</h2>
        <div class="row row-cols-1 row-cols-md-3 g-4">
            <% produtos.forEach(p => { %>
                <div class="col">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-body">
                            <span class="badge bg-secondary mb-2"><%= p.categoria %></span>
                            <h5 class="card-title fw-bold"><%= p.nome %></h5>
                            <p class="card-text text-success fw-bold fs-4">R$ <%= Number(p.preco).toFixed(2) %></p>
                            <p class="card-text text-muted">Estoque: <%= p.estoque %> un.</p>
                        </div>
                        <div class="card-footer bg-white border-0 d-flex justify-content-between pb-3">
                            <a href="/editar/<%= p.id %>" class="btn btn-outline-warning btn-sm"><i class="bi bi-pencil"></i> Editar</a>
                            <a href="/deletar/<%= p.id %>" class="btn btn-outline-danger btn-sm" onclick="return confirm('Excluir produto?')"><i class="bi bi-trash"></i> Excluir</a>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    </div>

</body>
</html>